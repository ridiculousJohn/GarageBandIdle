/* The screen's minimum legibility: a heading reads as a heading and a row
   reads as a row. Nothing decorative - presentation tuning is content. */

.screen {
    flex-grow: 1;
}

.sections {
    padding-left: 12px;
    padding-right: 12px;
    padding-top: 8px;
    padding-bottom: 8px;
}

.section {
    margin-bottom: 12px;
}

.section-title {
    -unity-font-style: bold;
    font-size: 18px;
    margin-bottom: 4px;
}

.currency-line {
    flex-direction: row;
    justify-content: space-between;
    margin-bottom: 2px;
}

.jam-button {
    margin-top: 6px;
}

.row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 4px;
}

.row-name {
    flex-grow: 1;
}

.row-count {
    min-width: 48px;
}

.row-buy {
    min-width: 120px;
}

.pool-readout {
    flex-direction: row;
    justify-content: space-between;
    margin-bottom: 2px;
}

.bar-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 4px;
}

.bar-name {
    min-width: 160px;
}

.bar-fill {
    flex-grow: 1;
    margin-left: 8px;
    margin-right: 8px;
}

.bar-progress {
    min-width: 96px;
}

.bar-select {
    min-width: 96px;
}

.legs {
    margin-top: 4px;
}

.leg {
    font-size: 12px;
    opacity: 0.8;
}

.preview {
    font-size: 12px;
}

.event-row {
    margin-bottom: 8px;
}

.event-status {
    font-size: 12px;
}

.event-buttons {
    flex-direction: row;
}

/* The select and the collect dialog are whole screens: each covers the panel,
   so the ScrollView's layout beneath never matters. */

.overlay {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.select {
    justify-content: center;
    align-items: center;
    padding: 24px;
}

.select-title {
    -unity-font-style: bold;
    font-size: 24px;
    margin-bottom: 16px;
}

.select-chapters {
    min-width: 320px;
}

.select-chapter {
    margin-bottom: 8px;
    font-size: 18px;
}

/* The scrim is what makes this read as a dialog and what absorbs input to
   anything beneath. */
.collect {
    justify-content: center;
    align-items: center;
    background-color: rgba(0, 0, 0, 0.6);
}

.collect-panel {
    min-width: 480px;
    padding: 24px;
    background-color: rgb(32, 32, 32);
}

.collect-title {
    -unity-font-style: bold;
    font-size: 20px;
    margin-bottom: 12px;
}

.collect-lines {
    margin-bottom: 12px;
}

.collect-ok {
    margin-top: 8px;
}
