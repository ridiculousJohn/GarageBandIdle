{
  "type": "RootDefinition",
  "id": "root",

  "declaredTags": ["income", "production"],

  "flags": ["ch1_complete", "story_ch1_open_seen", "story_ch1_end_seen",
            "ch2_complete", "story_ch2_open_seen", "story_ch2_end_seen"],

  "timers": ["encore_timer"],

  "entitlements": ["backstage_pass"],

  "encoreAdReward": [
    { "type": "ExtendTimer", "timer": "encore_timer", "seconds": 14400, "capSeconds": 86400 }
  ],

  "currencies": [
    { "id": "records", "displayName": "Records" },
    { "id": "roadies", "displayName": "Roadies" }
  ],

  "modifiers": [
    {
      "id": "records_income",
      "effects": [
        {
          "target": "income",
          "stat": "rate",
          "formula": { "type": "LinearOnBalance", "currency": "records", "coefficient": 0.02 }
        },
        {
          "target": "income",
          "stat": "yield",
          "formula": { "type": "LinearOnBalance", "currency": "records", "coefficient": 0.02 }
        }
      ]
    },
    {
      "id": "roadie_total",
      "effects": [
        {
          "target": "income",
          "stat": "rate",
          "formula": { "type": "RoadieTotalBoost", "perRoadie": 0.05 }
        },
        {
          "target": "income",
          "stat": "yield",
          "formula": { "type": "RoadieTotalBoost", "perRoadie": 0.05 }
        }
      ]
    },
    {
      "id": "roadie_active",
      "effects": [
        {
          "target": "production",
          "currencyId": "income",
          "stat": "rate",
          "formula": { "type": "RoadieActiveBoost", "perRoadie": 0.05 }
        },
        {
          "target": "production",
          "currencyId": "income",
          "stat": "yield",
          "formula": { "type": "RoadieActiveBoost", "perRoadie": 0.05 }
        }
      ]
    },
    {
      "id": "idle_base",
      "appliesWhen": { "type": "IdleAccumulation" },
      "effects": [
        { "stat": "rate", "multiplier": 0.5 },
        { "stat": "count", "multiplier": 0.5 }
      ]
    },
    {
      "id": "encore",
      "timer": "encore_timer",
      "appliesWhen": {
        "type": "Any",
        "conditions": [
          { "type": "HasEntitlement", "entitlementId": "backstage_pass" },
          { "type": "BuffActive", "modifier": "encore" }
        ]
      },
      "effects": [
        { "stat": "game_speed", "multiplier": 2 }
      ]
    }
  ],

  "permanentModifiers": ["records_income", "roadie_total", "roadie_active", "idle_base", "encore"]
}
