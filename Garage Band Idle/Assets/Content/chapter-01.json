        },
        {
          "prefabId": "generator_row",
          "contentId": "bassist",
          "visibleWhen": { "type": "FlagSet", "flagId": "bassist_revealed" }
        },
        {
          "prefabId": "generator_row",
          "contentId": "guitarist",
          "visibleWhen": { "type": "FlagSet", "flagId": "guitarist_revealed" }
        }
      ]
    },
    {
      "title": "The Gear",
      "description": "One-time buys that make everything else pay more. Cutting a demo clears them, and you buy them back faster each run.",
      "visibleWhen": { "type": "FlagSet", "flagId": "gear_revealed" },
      "scopeId": "tier1",
      "modules": [
        { "prefabId": "upgrade_row", "contentId": "stage_presence" },
        {
          "prefabId": "upgrade_row",
          "contentId": "amp_strings",
          "visibleWhen": { "type": "FlagSet", "flagId": "amp_strings_revealed" }
        },
        {
          "prefabId": "upgrade_row",
          "contentId": "kit_upgrade",
          "visibleWhen": { "type": "FlagSet", "flagId": "kit_upgrade_revealed" }
        },
        {
          "prefabId": "upgrade_row",
          "contentId": "tight_set",
          "visibleWhen": { "type": "FlagSet", "flagId": "tight_set_revealed" }
        },
        {
          "prefabId": "upgrade_row",
          "contentId": "play_for_crowd",
          "visibleWhen": { "type": "FlagSet", "flagId": "play_for_crowd_revealed" }
        },
        {
          "prefabId": "upgrade_row",
          "contentId": "unlock_covers",
          "visibleWhen": { "type": "FlagSet", "flagId": "unlock_covers_revealed" }
        }
      ]
    },
    {
      "title": "The Rehearsal Space",
      "description": "Rehearsal builds up while you play. Spend it learning covers, one at a time, and each one you learn draws a bigger crowd.",
      "visibleWhen": { "type": "FlagSet", "flagId": "rehearsal_revealed" },
      "scopeId": "tier1",
      "modules": [
        { "prefabId": "bar_group" }
      ]
    },
    {
      "title": "The Release",
      "description": "Cut a demo when you have 50 fans and a cover. It banks Records and Demo Tapes and resets the run.",
      "visibleWhen": { "type": "FlagSet", "flagId": "album" },
      "scopeId": "ch1",
      "modules": [
        { "prefabId": "rung_button", "scopeId": "tier1" }
      ]
    },
    {
      "title": "Garage Jam",
      "description": "Three timed sprints, one at a time. The band goes quiet and you tap alone for the goal, and clearing one pays more cash per tap for the rest of the chapter.",
      "visibleWhen": { "type": "CurrencyAtLeast", "currency": "records", "threshold": 1 },
      "scopeId": "tier1",
      "modules": [
        { "prefabId": "event_row", "contentId": "garage_jam_1" },
        { "prefabId": "event_row", "contentId": "garage_jam_2" },
        { "prefabId": "event_row", "contentId": "garage_jam_3" }
      ]
    },
    {
      "title": "The Backyard Party",
      "description": "The gig that ends the chapter. Hand out 30 Demo Tapes to get the show, and you walk away with your first Roadie.",
      "visibleWhen": { "type": "FlagSet", "flagId": "album" },
      "scopeId": "ch1",
      "modules": [
        { "prefabId": "rung_button" }
      ]
    }
  ],

