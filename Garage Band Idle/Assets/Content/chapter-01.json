    {
      "title": "The Band",
      "description": "Amps and the people to play them. They earn while you do nothing, and every bandmate brings fans of their own.",
      "visibleWhen": { "type": "FlagSet", "flagId": "band_revealed" },
      "scopeId": "tier1",
      "modules": [
        { "prefabId": "generator_row", "contentId": "practice_amp" },
        {
          "prefabId": "generator_row",
          "contentId": "drummer",
