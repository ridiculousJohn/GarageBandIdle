      visibleWhen:
        rid: -2
      scope: {fileID: 11400000, guid: 7730b93caaf305b48bad38f664d1aca2, type: 2}
  - title: The Backyard Party
    description: The gig that ends the chapter. Hand out 30 Demo Tapes to get the
      show, and you walk away with your first Roadie.
    visibleWhen:
