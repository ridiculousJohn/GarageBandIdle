    description: Amps and the people to play them. They earn while you do nothing,
      and every bandmate brings fans of their own.
    visibleWhen:
      rid: 7579425512644149319
    scope: {fileID: 11400000, guid: 7730b93caaf305b48bad38f664d1aca2, type: 2}
